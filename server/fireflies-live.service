[Unit]
Description=Fireflies Live (meeting copilot) — static app + localhost bridge
After=network-online.target tailscaled.service
OnFailure=os-ping-fail@%n.service

[Service]
WorkingDirectory=/opt/Thrivbe-AI/lab/fireflies-live
Environment=SERVE_PORT=3017
Environment=SERVE_HOST=0.0.0.0
Environment=SERVE_HOSTS=100.114.219.63:3017,hetzner.tail9908c7.ts.net:3017,hetzner:3017,localhost:3017,127.0.0.1:3017
Environment=SERVE_ENV_FILE=/opt/Thrivbe-AI/.env
Environment=BRIDGE_CONTENT_ROOT=/opt/Thrivbe-AI/content
Environment=BRIDGE_CLIENTS_ROOT=/opt/Thrivbe-AI/clients
Environment=BRIDGE_FILE_DIR=/opt/Thrivbe-AI/content/meetings/transcripts
ExecStart=/usr/bin/node server/serve.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
