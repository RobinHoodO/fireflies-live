{
  "name": "fireflies-live",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config v2/vite.config.ts",
    "build": "tsc -p tsconfig.v2.json --noEmit && vite build --config v2/vite.config.ts",
    "lint": "oxlint v2 server",
    "preview": "vite preview --config v2/vite.config.ts",
    "typecheck:v2": "tsc -p tsconfig.v2.json --noEmit",
    "test": "node --test",
    "verify": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "oxlint": "^1.69.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.0"
  }
}
