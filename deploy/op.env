# /etc/fireflies-live/op.env — 1Password ADDRESSES only, never values. Install root:root 0600.
# Only these three secrets go through oprun, so the other workspace keys stay out of this process.
# The FIREFLIES_ALLOWED_* policy lines do NOT belong here: they stay plaintext in SERVE_ENV_FILE
# (/opt/Thrivbe-AI/.env), so an edit takes effect on the next request with no restart.
FIREFLY_API_KEY=op://Thrivbe-Core/Firefly/credential
OPENROUTER_API_KEY=op://Thrivbe-Core/Openrouter-5fbf41/credential
FIREFLIES_APP_SECRET=op://Thrivbe-Core/Fireflies-App-Secret/credential
