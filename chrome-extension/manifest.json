{
  "manifest_version": 3,
  "name": "Fireflies Live Launcher",
  "version": "1.2.0",
  "description": "Dock Fireflies Live beside the call: see which meeting tab the notetaker joined, then join live in one click.",
  "key": "",
  "permissions": ["tabs", "sidePanel", "scripting"],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://*.zoom.us/*",
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "Fireflies Live" },
  "icons": { "16": "icon.png", "48": "icon.png", "128": "icon.png" }
}
